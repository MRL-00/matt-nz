---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../site';
import { readingStats, formatWords } from '../../lib/reading';

export async function getStaticPaths() {
  const posts = (await getCollection('writing', ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: posts[i + 1] ?? null,
      next: posts[i - 1] ?? null,
    },
  }));
}

type Props = {
  post: CollectionEntry<'writing'>;
  prev: CollectionEntry<'writing'> | null;
  next: CollectionEntry<'writing'> | null;
};

const { post, prev, next } = Astro.props as Props;
const { Content, headings } = await render(post);
const stats = readingStats(post.body ?? '');

const d = post.data.date;
const dateStr = d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const editedStr = post.data.edited
  ? post.data.edited.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
  : null;

const toc = headings.filter(h => h.depth === 2);
---
<BaseLayout
  title={post.data.title}
  description={post.data.excerpt}
  current="writing"
  article={{
    publishedTime: d.toISOString(),
    modifiedTime: post.data.edited?.toISOString(),
    tags: post.data.tags,
  }}
>
  <article class="max-w-[720px] mx-auto pt-4">
    <!-- Top Back Link -->
    <div class="mb-10">
      <a href="/writing" class="font-sans text-[13px] text-dim hover:text-accent inline-flex items-center gap-1.5 transition-colors">
        &larr; Back to writing
      </a>
    </div>

    <!-- Article Header -->
    <header class="mb-12">
      <div class="flex items-center gap-2.5 font-mono text-[12.5px] text-muted mb-4 flex-wrap">
        <span>{dateStr}</span>
        <span>&middot;</span>
        <span>{stats.minutes} min read</span>
        <span>&middot;</span>
        <span>{formatWords(stats.words)} words</span>
        {post.data.location && (
          <>
            <span>&middot;</span>
            <span>{post.data.location}</span>
          </>
        )}
        {editedStr && (
          <>
            <span>&middot;</span>
            <span>Updated {editedStr}</span>
          </>
        )}
      </div>

      <h1 class="font-serif text-[36px] sm:text-[44px] leading-[1.18] font-medium tracking-tight text-[var(--text)] mb-6">
        {post.data.title}
      </h1>

      <p class="font-serif text-[19px] sm:text-[21px] leading-[1.6] text-dim border-l-2 border-[var(--accent)] pl-5 italic">
        {post.data.excerpt}
      </p>

      <div class="flex items-center gap-2 mt-6 flex-wrap">
        {post.data.tags.map(t => (
          <span class="tag">{t}</span>
        ))}
      </div>
    </header>

    <!-- Table of Contents (if essay has sections) -->
    {toc.length > 0 && (
      <nav class="mb-12 p-6 bg-card border bd rounded-xl font-sans">
        <div class="text-[12px] uppercase font-semibold tracking-wider text-muted mb-3">Sections in this essay</div>
        <ol class="space-y-2 text-[14px]">
          {toc.map((h, i) => (
            <li>
              <a href={`#${h.slug}`} class="text-dim hover:text-accent transition-colors flex items-baseline gap-2">
                <span class="font-mono text-muted text-[11px]">{String(i + 1).padStart(2, '0')}.</span>
                <span>{h.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <!-- Essay Body -->
    <div class="prose-body">
      <Content />
    </div>

    <!-- Article Footer / Share -->
    <div class="mt-16 pt-8 border-t bd space-y-8 font-sans">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="text-[14px] text-dim font-serif">
          Thoughts or counterarguments? DMs and replies welcome on
          <a href="https://x.com/codermatt" class="lk-u font-sans font-medium">X (@codermatt)</a>.
        </div>
        <div class="flex items-center gap-4 text-[13px]">
          <button id="copy-link" class="text-dim hover:text-accent transition-colors cursor-pointer bg-transparent border-none p-0">
            Copy link
          </button>
          <span class="text-muted">&middot;</span>
          <a
            class="text-dim hover:text-accent transition-colors"
            href={`https://x.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(new URL(`/writing/${post.id}`, site.url).toString())}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Share on X
          </a>
        </div>
      </div>

      <!-- Previous / Next post nav -->
      <nav class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-6 border-t border-[var(--hairline)]">
        <div>
          {prev ? (
            <a href={`/writing/${prev.id}`} class="group block p-4 bg-card border bd rounded-lg hover:border-[var(--accent)] transition-all">
              <span class="text-muted text-[11px] uppercase font-mono">&larr; Previous</span>
              <span class="block mt-1 font-serif text-[15px] font-medium text-[var(--text)] group-hover:text-accent transition-colors">
                {prev.data.title}
              </span>
            </a>
          ) : null}
        </div>
        <div>
          {next ? (
            <a href={`/writing/${next.id}`} class="group block p-4 bg-card border bd rounded-lg hover:border-[var(--accent)] text-right transition-all">
              <span class="text-muted text-[11px] uppercase font-mono">Next &rarr;</span>
              <span class="block mt-1 font-serif text-[15px] font-medium text-[var(--text)] group-hover:text-accent transition-colors">
                {next.data.title}
              </span>
            </a>
          ) : null}
        </div>
      </nav>
    </div>
  </article>

  <script is:inline>
    (function () {
      var btn = document.getElementById('copy-link');
      if (btn) {
        btn.addEventListener('click', function () {
          var url = window.location.href;
          if (navigator.clipboard) {
            navigator.clipboard.writeText(url).then(function () {
              var orig = btn.textContent;
              btn.textContent = 'Link copied ✓';
              setTimeout(function () { btn.textContent = orig; }, 1600);
            });
          }
        });
      }
    })();
  </script>
</BaseLayout>
