---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readingStats } from '../../lib/reading';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---
<BaseLayout title="Writing" current="writing" description="Notes on backends, mobile, and the politics of getting software out the door.">
  <div class="space-y-12">
    <!-- Header -->
    <header class="pt-4">
      <div class="font-mono text-[12px] uppercase tracking-wider text-muted mb-2">Essay Collection</div>
      <h1 class="font-serif text-[38px] sm:text-[42px] leading-[1.2] font-medium tracking-tight text-[var(--text)]">
        Writing
      </h1>
      <p class="font-serif text-[18px] sm:text-[19px] leading-[1.65] text-dim mt-4 max-w-[62ch]">
        Long-form thoughts on distributed systems, mobile development, agent harnesses, and the hard human parts of delivering software.
      </p>
      <div class="flex items-center gap-4 mt-6 text-[13px] font-sans text-muted">
        <span>{posts.length} {posts.length === 1 ? 'essay' : 'essays'} published</span>
        <span>&middot;</span>
        <a href="/feed.xml" class="text-dim hover:text-accent flex items-center gap-1.5 transition-colors">
          Subscribe via RSS &rarr;
        </a>
      </div>
    </header>

    <!-- Articles List -->
    <div class="border-t bd pt-10 space-y-10">
      {posts.map((p) => {
        const stats = readingStats(p.body ?? '');
        return (
          <article class="group block p-7 sm:p-8 bg-card border bd rounded-xl transition-all duration-200 hover:-translate-y-0.5 hover:border-[var(--accent)] shadow-sm">
            <a href={`/writing/${p.id}`} class="block">
              <div class="flex items-center gap-2.5 font-mono text-[12px] text-muted mb-3">
                <span>{fmtDate(p.data.date)}</span>
                <span>&middot;</span>
                <span>{stats.minutes} min read</span>
                {p.data.location && (
                  <>
                    <span>&middot;</span>
                    <span>{p.data.location}</span>
                  </>
                )}
              </div>
              <h2 class="font-serif text-[26px] sm:text-[28px] font-medium leading-[1.25] text-[var(--text)] group-hover:text-accent transition-colors mb-3">
                {p.data.title}
              </h2>
              <p class="font-serif text-[16px] sm:text-[17px] leading-[1.7] text-dim mb-5 max-w-[70ch]">
                {p.data.excerpt}
              </p>
            </a>
            <div class="flex items-center justify-between pt-4 border-t border-[var(--hairline)] flex-wrap gap-3">
              <div class="flex items-center gap-2 flex-wrap">
                {p.data.tags.map(t => (
                  <span class="tag">{t}</span>
                ))}
              </div>
              <a href={`/writing/${p.id}`} class="font-sans text-[13px] font-medium text-accent inline-flex items-center gap-1">
                Read essay &rarr;
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Footer note -->
    <footer class="pt-8 border-t border-[var(--hairline)] flex justify-between items-center text-[13px] font-sans text-muted">
      <span>matt-nz.com &middot; writing</span>
      <a href="/" class="hover:text-accent transition-colors">&larr; back to home</a>
    </footer>
  </div>
</BaseLayout>
