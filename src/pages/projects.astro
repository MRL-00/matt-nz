---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { statusGlyph } from '../site';

const all = await getCollection('projects');

// Sort: explicit order first, then year desc
const projects = all.sort((a, b) => {
  const ao = a.data.order ?? 999;
  const bo = b.data.order ?? 999;
  if (ao !== bo) return ao - bo;
  return b.data.year - a.data.year;
});

// Tag counts
const tagCounts = new Map<string, number>();
for (const p of projects) {
  for (const t of p.data.tech) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
}
const tags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10);
---
<BaseLayout title="Projects" current="projects" description="Side projects, libraries, and tools built over the years.">
  <div class="space-y-12">
    <!-- Header -->
    <header class="pt-4">
      <div class="font-mono text-[12px] uppercase tracking-wider text-muted mb-2">Portfolio &amp; Open Source</div>
      <h1 class="font-serif text-[38px] sm:text-[42px] leading-[1.2] font-medium tracking-tight text-[var(--text)]">
        Projects
      </h1>
      <p class="font-serif text-[18px] sm:text-[19px] leading-[1.65] text-dim mt-4 max-w-[62ch]">
        Side projects, developer tools, native clients, and a few experiments that quietly turned into products.
      </p>

      <!-- Tag Filters -->
      <div class="flex items-center gap-2 mt-8 flex-wrap font-sans text-[13px]" id="filter-bar">
        <a
          href="/projects"
          class="filter-pill px-3 py-1 rounded-full border bd text-dim hover:text-accent transition-all cursor-pointer"
          data-tag=""
        >
          All ({projects.length})
        </a>
        {tags.map(([t, n]) => (
          <a
            href={`/projects?tag=${encodeURIComponent(t)}`}
            class="filter-pill px-3 py-1 rounded-full border bd text-dim hover:text-accent transition-all cursor-pointer font-mono text-[12px]"
            data-tag={t}
          >
            #{t} <span class="text-muted text-[11px]">({n})</span>
          </a>
        ))}
      </div>
    </header>

    <!-- Projects Grid -->
    <div class="border-t bd pt-10">
      <div id="projects-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {projects.map((p) => (
          <article
            class="project-card group p-6 bg-card border bd rounded-xl flex flex-col justify-between transition-all duration-200 hover:-translate-y-0.5 hover:border-[var(--accent)] shadow-sm"
            data-tags={p.data.tech.join(' ')}
          >
            <div>
              <div class="flex items-baseline justify-between gap-2 mb-2">
                <h3 class="font-sans font-semibold text-[17px] text-[var(--text)] group-hover:text-accent transition-colors flex items-center gap-2">
                  <span>{p.data.title}</span>
                  {p.data.status === 'active' && <span class="text-accent text-[11px]">{statusGlyph(p.data.status)}</span>}
                </h3>
                <span class="font-mono text-[12px] text-muted">{p.data.year}</span>
              </div>
              <p class="font-serif text-[15px] sm:text-[15.5px] leading-[1.6] text-dim mb-5">
                {p.data.blurb}
              </p>
            </div>
            <div class="pt-3 border-t border-[var(--hairline)] flex items-center justify-between flex-wrap gap-2">
              <div class="flex flex-wrap gap-2">
                {p.data.tech.slice(0, 3).map(t => (
                  <span class="tag">{t}</span>
                ))}
              </div>
              {p.data.url && (
                <a
                  href={p.data.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-sans text-[12.5px] font-medium text-accent inline-flex items-center gap-1 hover:underline"
                >
                  {p.data.linkLabel ?? 'View'} &rarr;
                </a>
              )}
            </div>
          </article>
        ))}
      </div>

      <p id="empty-state" class="mt-8 text-muted font-serif text-[16px] text-center py-12" style="display: none;">
        No projects match this tag. <a href="/projects" class="lk-u text-accent">Show all projects</a>
      </p>
    </div>

    <!-- Footer note -->
    <footer class="pt-8 border-t border-[var(--hairline)] flex justify-between items-center text-[13px] font-sans text-muted">
      <span>matt-nz.com &middot; projects</span>
      <a href="/" class="hover:text-accent transition-colors">&larr; back to home</a>
    </footer>
  </div>

  <script is:inline>
    (function () {
      var grid = document.getElementById('projects-grid');
      if (!grid) return;
      var cards = grid.querySelectorAll('.project-card');
      var emptyMsg = document.getElementById('empty-state');
      var pills = document.querySelectorAll('.filter-pill');

      function apply(tag) {
        var visible = 0;
        cards.forEach(function (c) {
          var tags = (c.getAttribute('data-tags') || '').split(' ');
          var match = !tag || tags.indexOf(tag) !== -1;
          c.style.display = match ? 'flex' : 'none';
          if (match) visible++;
        });

        if (emptyMsg) emptyMsg.style.display = visible === 0 ? 'block' : 'none';

        pills.forEach(function (p) {
          var t = p.getAttribute('data-tag') || '';
          var active = t === (tag || '');
          if (active) {
            p.style.backgroundColor = 'var(--surface)';
            p.style.borderColor = 'var(--accent)';
            p.style.color = 'var(--text)';
          } else {
            p.style.backgroundColor = '';
            p.style.borderColor = '';
            p.style.color = '';
          }
        });
      }

      function readTag() {
        try {
          var u = new URL(window.location.href);
          return u.searchParams.get('tag') || '';
        } catch (_) { return ''; }
      }

      apply(readTag());

      pills.forEach(function (p) {
        p.addEventListener('click', function (e) {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          e.preventDefault();
          var t = p.getAttribute('data-tag') || '';
          var url = t ? '/projects?tag=' + encodeURIComponent(t) : '/projects';
          history.pushState({}, '', url);
          apply(t);
        });
      });

      window.addEventListener('popstate', function () { apply(readTag()); });
    })();
  </script>
</BaseLayout>
